{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EasyKeeper",
  "version": "0.1.0",
  "identifier": "easykeeper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:47231",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self'; media-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "EasyKeeper",
    "category": "Utility",
    "shortDescription": "Desktop toolbox for game masters",
    "longDescription": "EasyKeeper is a modular desktop toolbox for game masters to prepare and run games.",
    "homepage": "https://github.com/weisy11/EasyKeeper",
    "copyright": "Copyright (c) 2026 EasyKeeper contributors",
    "license": "Apache-2.0",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
